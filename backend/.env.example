# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek-compatible API base URL (used for vision calls).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (JSON list of allowed origins, e.g. ["http://localhost:5173"])
CORS_ORIGINS=["*"]

# Runs
RUN_TIMEOUT_SECONDS=300
RUN_MAX_CONCURRENT=4
RUN_QUEUE_MAX=100

# Auth (disabled by default for local dev; set API_KEYS before exposing)
AUTH_ENABLED=false
API_KEYS=

# Rate limiting (per API key or client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Web search (free DuckDuckGo backend; results are cached to avoid rate limits)
SEARCH_PROVIDER=duckduckgo
SEARCH_REGION=us-en
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10
SEARCH_CACHE_TTL_SECONDS=600
SEARCH_CACHE_MAX_ENTRIES=1000

# Observability
LOG_JSON=true
METRICS_ENABLED=true
OTEL_ENABLED=false

# Reliability
MODEL_RETRIES=2
# Optional OpenAI-compatible fallback used when the primary model errors.
MODEL_FALLBACK=
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_API_KEY=

# Database (async SQLAlchemy URL). Use postgresql+asyncpg for Postgres,
# or sqlite+aiosqlite for local/test runs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agents
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Document uploads + compliance checking.
# Uploads are stored locally under UPLOAD_DIR, keyed by sha1 of the bytes.
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=20971520
# Uploads older than this are removed by the janitor (seconds).
UPLOAD_TTL_SECONDS=86400
# Vision model used to analyse document page visuals (diagrams, scans, logos).
DOC_VISION_MODEL=deepseek-v4-flash-vision-exp
DOC_VISION_ENABLED=true
DOC_MAX_VISION_PAGES=8
# Optional path to a YAML file of extra sensitive-data rules.
COMPLIANCE_RULES_PATH=
COMPLIANCE_MAX_TEXT_CHARS=60000